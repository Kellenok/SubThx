{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "subthx",
  "version": "0.1.0",
  "identifier": "app.subthx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "subthx",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}